generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id                String      @id @default(cuid())
  cargo             String?
  email             String?
  telefone          String?
  endereco          String?
  cidade            String?
  estado            String?
  categoria         String?
  status            String      @default("Ativo")
  observacoes       String?
  criadoEm          DateTime    @default(now())
  atualizadoEm      DateTime    @updatedAt
  aceitaEmail       Boolean     @default(true)
  bairro            String?
  cep               String?
  cnpj              String?
  contato           String?
  nomeFantasia      String?
  razaoSocial       String
  regiao            String?
  rota              String?
  whatsapp          String?
  inscricaoEstadual String?
  interacoes        Interacao[]
  vendas            Venda[]
}

model Representada {
  id                 String   @id @default(cuid())

  nome               String
  cnpj               String?

  endereco           String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  cep                String?

  ie                 String?

  comissao           Float?

  status             String   @default("Ativa")

  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  bancoComissao      String?

  contatoPrincipal   String?
  emailPrincipal     String?
  telefonePrincipal  String?
  whatsappPrincipal  String?

  fechamentoComissao String?
  pagamentoComissao  String?

  observacoes        String?
  codigo             String?

  contratoAssinado   Boolean  @default(false)
  emiteNF            Boolean  @default(true)

  tipoComissao       String?  @default("fixa")
  faixasComissao     String?

  vendas             Venda[]
}

model Venda {
  id                  String       @id @default(cuid())
  data                DateTime
  clienteId           String
  representadaId      String
  produto             String?
  quantidade          Int?
  valorTotal          Float?
  comissao            Float?
  status              String       @default("Pendente")
  observacoes         String?
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt
  arquivoUrl          String?
  condicaoPagamento   String?
  desconto            Float?
  numeroPedido        String?
  previsaoFaturamento DateTime?

  cliente             Cliente      @relation(fields: [clienteId], references: [id])
  representada        Representada @relation(fields: [representadaId], references: [id])
}

model Interacao {
  id            String   @id @default(cuid())
  data          DateTime
  clienteId     String
  tipo          String
  assunto       String?
  descricao     String?
  resultado     String?
  proximosPasso String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

model Financeiro {
  id           String    @id @default(cuid())
  data         DateTime
  tipo         String
  categoria    String?
  descricao    String?
  valor        Float
  status       String    @default("Pendente")
  vencimento   DateTime?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}